<Window x:Class="YeyouPlusPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="页游++" Height="720" Width="1180" MinHeight="560" MinWidth="880"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBg}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        Icon="pack://siteoforigin:,,,/Assets/app-64.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="164"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧边栏（可收拢） ============ -->
        <Border x:Name="Sidebar" Grid.Column="0"
                Background="{DynamicResource Theme.SidebarBg}"
                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 顶部标识 -->
                <StackPanel x:Name="SidebarHeader" DockPanel.Dock="Top"
                            Orientation="Horizontal" Margin="14,14,8,12">
                    <Image Width="26" Height="26" Source="pack://siteoforigin:,,,/Assets/app-64.png"/>
                    <TextBlock x:Name="SidebarTitle" Text="页游++" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="9,0,0,0"
                               Foreground="{DynamicResource Theme.TextPrimary}"/>
                </StackPanel>

                <!-- 底部收拢/展开按钮 -->
                <Button x:Name="ToggleSidebarButton" DockPanel.Dock="Bottom"
                        Style="{StaticResource SidebarButton}" Click="ToggleSidebarButton_Click"
                        ToolTip="收拢 / 展开侧边栏" Margin="8,4,8,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToggleSidebarIcon" Text="&#xE76B;"
                                   FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Width="22" TextAlignment="Center"/>
                        <TextBlock x:Name="ToggleSidebarText" Text="收拢侧边栏" Margin="9,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 导航 -->
                <StackPanel Margin="8,2,8,0">
                    <Button x:Name="NavHomeButton" Style="{StaticResource SidebarButton}"
                            Click="NavHome_Click" ToolTip="主页">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock x:Name="NavHomeText" Text="主页" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Grid Margin="0,2,0,0">
                        <Button x:Name="NavSettingsButton" Style="{StaticResource SidebarButton}"
                                Click="NavSettings_Click" ToolTip="设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" Width="22" TextAlignment="Center"/>
                                <TextBlock x:Name="NavSettingsText" Text="设置" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <!-- 新稳定版提示小红点 -->
                        <Ellipse x:Name="UpdateBadge" Width="9" Height="9"
                                 Fill="{DynamicResource Theme.Danger}"
                                 Stroke="White" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,3,10,0" Visibility="Collapsed"
                                 ToolTip="发现新的稳定版本"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 主内容区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 『 主页 』-->
            <Grid x:Name="HomePanel" Grid.Row="0">
                <Viewbox x:Name="HomeViewbox" Stretch="Uniform"
                         MaxWidth="860" MaxHeight="540"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Width="780" Height="440">
                        <TextBlock Text="页游++" FontSize="46" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="行至水穷处，坐看云起时" FontSize="15"
                                   HorizontalAlignment="Center" Margin="0,10,0,34"
                                   Foreground="{DynamicResource Theme.TextSecondary}"/>

                        <!-- 搜索框（带阴影，与下方卡片按钮一致） -->
                        <Grid Width="620" HorizontalAlignment="Center">
                            <TextBox x:Name="HomeSearchBox" Height="52" FontSize="16"
                                     Padding="18,0" KeyDown="HomeSearchBox_KeyDown"
                                     TextChanged="HomeSearchBox_TextChanged">
                                <TextBox.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                      Color="#26000000" Opacity="1"/>
                                </TextBox.Effect>
                            </TextBox>
                            <TextBlock x:Name="HomeSearchHint" Text="搜索或输入网址" FontSize="16"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       VerticalAlignment="Center" Margin="19,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                       FontSize="16" Foreground="{DynamicResource Theme.TextSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,18,0" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- 5 个快捷入口 -->
                        <UniformGrid x:Name="QuickLinkPanel" Columns="5" Width="620"
                                     Margin="0,44,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Viewbox>
            </Grid>

            <!-- 『 浏览器视图 』-->
            <Grid x:Name="BrowserView" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="8" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                                Margin="0,0,5,0" Click="BackButton_Click" ToolTip="后退"/>
                        <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;"
                                Margin="0,0,5,0" Click="ForwardButton_Click" ToolTip="前进"/>
                        <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                Margin="0,0,5,0" Click="ReloadButton_Click" ToolTip="刷新"/>
                        <Button x:Name="HomeButton" Height="32" Padding="12,0" Margin="0,0,5,0"
                                Click="HomeButton_Click" ToolTip="返回主页">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                <TextBlock Text="主页" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- 网页缩放 -->
                        <Button x:Name="ZoomButton" Style="{StaticResource IconButton}" Content="&#xE8A3;"
                                Margin="0,0,5,0" Click="ZoomButton_Click" ToolTip="页面缩放"/>
                        <!-- 变速 -->
                        <ComboBox x:Name="SpeedCombo" Width="74" Height="32" Margin="0,0,5,0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="SpeedCombo_SelectionChanged" ToolTip="游戏变速"/>
                        <!-- 收藏 -->
                        <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Content="&#xE735;"
                                Margin="0,0,5,0" Click="FavoriteButton_Click" ToolTip="收藏当前页"/>
                        <Button x:Name="FavoritesButton" Style="{StaticResource IconButton}" Content="&#xE700;"
                                Margin="0,0,5,0" Click="FavoritesButton_Click" ToolTip="收藏夹"/>
                        <!-- 清缓存 -->
                        <Button x:Name="ClearCacheButton" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                Click="ClearCacheButton_Click" ToolTip="清理缓存"/>
                    </StackPanel>

                    <TextBox x:Name="AddressBox" Height="32" Margin="5,0"
                             KeyDown="AddressBox_KeyDown"
                             ToolTip="输入网址或搜索关键词"/>
                </DockPanel>

                <Grid x:Name="BrowserContainer" Grid.Row="1"/>
            </Grid>

            <!-- 『 设置视图 』-->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="660" Margin="30,24" HorizontalAlignment="Left">

                    <TextBlock Text="设置" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextPrimary}"/>

                    <!-- 存储 -->
                    <TextBlock Text="存储" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8"
                               Foreground="{DynamicResource Theme.TextSecondary}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="数据存储路径（收藏、快捷入口、下载等）"
                                       FontSize="13" Foreground="{DynamicResource Theme.TextSecondary}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DataDirBox" Height="32" IsReadOnly="True"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="ChangeDataDirButton" Grid.Column="1" Content="更改…"
                                        Height="32" Margin="8,0,0,0" Click="ChangeDataDirButton_Click"/>
                            </Grid>

                            <TextBlock Text="下载保存路径" FontSize="13" Margin="0,16,0,0"
                                       Foreground="{DynamicResource Theme.TextSecondary}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DownloadDirBox" Height="32" IsReadOnly="True"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="ChangeDownloadDirButton" Grid.Column="1" Content="更改…"
                                        Height="32" Margin="8,0,0,0" Click="ChangeDownloadDirButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 更新 -->
                    <TextBlock Text="更新" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8"
                               Foreground="{DynamicResource Theme.TextSecondary}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentVersionText" FontSize="14" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Theme.Hover}" CornerRadius="4"
                                            Margin="8,0,0,0" Padding="6,2">
                                        <TextBlock Text="测试版" FontSize="11"
                                                   Foreground="{DynamicResource Theme.TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                                <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新"
                                        Height="32" Click="CheckUpdateButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="UpdateStatusText" FontSize="12" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondary}"/>

                            <TextBlock Text="可用版本（选择后覆盖安装，配置与数据保留）" FontSize="13"
                                       Margin="0,16,0,6" Foreground="{DynamicResource Theme.TextSecondary}"/>
                            <ListBox x:Name="ReleaseList" MaxHeight="190"
                                     MouseDoubleClick="ReleaseList_MouseDoubleClick"/>
                            <Button x:Name="InstallButton" Content="安装所选版本" Width="130" Height="32"
                                    Margin="0,10,0,0" HorizontalAlignment="Right"
                                    Click="InstallButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 关于 -->
                    <TextBlock Text="关于" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8"
                               Foreground="{DynamicResource Theme.TextSecondary}"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.TextPrimary}"
                                       Text="硬件加速：已启用（GPU 合成渲染，无需配置）。"/>
                            <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Theme.TextSecondary}"/>
                            <TextBlock x:Name="RepoLinkText" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{DynamicResource Theme.Accent}" Cursor="Hand"
                                       MouseLeftButtonUp="RepoLink_Click"
                                       Text="项目仓库：github.com/bilibilibaiyun/yeyou-plus-plus"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 『 状态栏 』-->
            <Border Grid.Row="1" Background="{DynamicResource Theme.CardBg}"
                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0"
                    Padding="12,4">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12"
                           Foreground="{DynamicResource Theme.TextSecondary}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
