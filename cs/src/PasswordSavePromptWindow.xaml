<Window x:Class="YeyouPlusPlus.PasswordSavePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存密码" Height="210" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBg}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        Icon="pack://siteoforigin:,,,/Assets/app-64.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" FontSize="14" TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Theme.TextPrimary}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="不保存" Width="90" Height="32" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="保存" Width="90" Height="32"
                    Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
