<Window x:Class="YeyouPlusPlus.QuickLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加快捷入口" Height="256" Width="436"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBg}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        Icon="pack://siteoforigin:,,,/Assets/app-64.png">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="地址" FontSize="13" Margin="0,0,0,6"
                   Foreground="{DynamicResource Theme.TextSecondary}"/>
        <TextBox x:Name="AddressBox" Grid.Row="1" Height="34" FontSize="14"
                 Padding="8,0"/>

        <TextBlock Grid.Row="2" Text="名称（可选）" FontSize="13" Margin="0,14,0,6"
                   Foreground="{DynamicResource Theme.TextSecondary}"/>
        <TextBox x:Name="NameBox" Grid.Row="3" Height="34" FontSize="14"
                 Padding="8,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="80" Height="32" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="保存" Width="80" Height="32" Style="{StaticResource PrimaryButton}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
