<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <!-- 工具条：返回 / 刷新 / 地址栏 / 收藏 / 主页 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp">

        <Button
            android:id="@+id/flash_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/flash_back"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_join_input" />

        <Button
            android:id="@+id/flash_refresh"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/flash_refresh"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_join_input" />

        <EditText
            android:id="@+id/flash_address"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:hint="@string/flash_address_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="14sp"
            android:inputType="textUri"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_join_input" />

        <Button
            android:id="@+id/flash_favorite"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/flash_favorite"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_join_input" />

        <Button
            android:id="@+id/flash_home"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/flash_home"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_connect_button" />
    </LinearLayout>

    <!-- 页面 / Flash 游戏 -->
    <WebView
        android:id="@+id/flash_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
