<Window x:Class="YeyouPlusPlus.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YeyouPlusPlus"
        Title="收藏夹" Height="500" Width="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBg}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        Icon="pack://siteoforigin:,,,/Assets/app-64.png">
    <Window.Resources>
        <local:FavoriteNodeTemplateSelector x:Key="NodeTemplateSelector"/>

        <DataTemplate x:Key="BookmarkTemplate">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Url}">
                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           VerticalAlignment="Center" Foreground="{DynamicResource Theme.Accent}"/>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource Theme.TextPrimary}"/>
            </StackPanel>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="FolderTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <Button Content="关闭" DockPanel.Dock="Right" Width="60" Height="32" Click="Close_Click"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="新建文件夹" Width="96" Height="32" Click="NewFolder_Click"/>
                <Button Content="重命名" Width="74" Height="32" Margin="6,0,0,0" Click="Rename_Click"/>
                <Button Content="移动到…" Width="82" Height="32" Margin="6,0,0,0" Click="Move_Click"/>
                <Button Content="删除" Width="64" Height="32" Margin="6,0,0,0" Click="Delete_Click"/>
            </StackPanel>
        </DockPanel>

        <TreeView x:Name="Tree" Grid.Row="1"
                  Background="{DynamicResource Theme.CardBg}"
                  Foreground="{DynamicResource Theme.TextPrimary}"
                  BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                  Padding="4"
                  ItemTemplateSelector="{StaticResource NodeTemplateSelector}"
                  MouseDoubleClick="Tree_MouseDoubleClick"
                  PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                    <Setter Property="Padding" Value="4,3"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开" Click="Open_Click"/>
                    <MenuItem Header="重命名…" Click="Rename_Click"/>
                    <MenuItem Header="移动到文件夹…" Click="Move_Click"/>
                    <Separator/>
                    <MenuItem Header="删除" Click="Delete_Click"/>
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
    </Grid>
</Window>
