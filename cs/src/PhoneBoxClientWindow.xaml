<Window x:Class="YeyouPlusPlus.PhoneBoxClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="电脑连电脑 · 从机连接" Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        MinHeight="440" MinWidth="620"
        Background="{DynamicResource Theme.WindowBg}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="电脑连电脑 · 从机连接" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="输入主机生成的 8 位联机码，配对后接收推流画面，用键盘 / 鼠标操作把按键发回主机。"
                       FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 联机码输入 + 连接 / 断开 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="JoinCodeBox" Height="36" FontSize="15" Padding="10,0"
                     VerticalContentAlignment="Center" MaxLength="8"/>
            <Button x:Name="ActionButton" Grid.Column="1" Content="连接"
                    Height="36" Margin="8,0,0,0" Padding="18,0"
                    Style="{StaticResource PrimaryButton}" Click="ActionButton_Click"/>
        </Grid>

        <!-- 状态 -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="未连接" FontSize="13" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>

        <!-- 画面（按宽高比居中，虚拟按键覆盖其上） -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="0">
            <Viewbox x:Name="VideoViewbox" Stretch="Uniform">
                <Grid x:Name="VideoFrame" Width="1280" Height="720" Background="Black">
                    <Image x:Name="VideoImage" Stretch="Fill"/>
                </Grid>
            </Viewbox>
        </Border>

        <!-- 底部提示 + 关闭 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="键盘：方向键 / Z / X / C / V / 空格 / 回车；也可用鼠标点击画面上的虚拟按键。"
                       FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="关闭" Height="34" Padding="16,0" Margin="16,0,0,0"
                    HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
