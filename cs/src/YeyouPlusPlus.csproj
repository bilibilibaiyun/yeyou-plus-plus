<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>YeyouPlusPlus</AssemblyName>
    <RootNamespace>YeyouPlusPlus</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <StartupObject>YeyouPlusPlus.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.4.1</Version>
    <AssemblyVersion>2.4.1.0</AssemblyVersion>
    <FileVersion>2.4.1.0</FileVersion>
    <ApplicationIcon>..\..\assets\icon\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon\app-64.png" Link="Assets\app-64.png" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="..\..\assets\video\intro.mp4" Link="Assets\video\intro.mp4" CopyToOutputDirectory="PreserveNewest"/>
    <!-- OpenH264 软编码 native 库（Cisco 官方预编译 win64，BSD 许可）。 -->
    <None Include="native\openh264.dll" Link="openh264.dll" CopyToOutputDirectory="PreserveNewest"/>
    <!-- EasyTier 跨网络组网运行时（AGPL-3.0，见 THIRD_PARTY_NOTICES）。 -->
    <None Include="..\..\engine\easytier\**\*" Link="easytier\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <!-- net462 默认不引用 System.Net.Http，需显式引用以使用 HttpClient。 -->
    <Reference Include="System.Net.Http" />
    <!-- Base62 联机码编码使用 BigInteger。 -->
    <Reference Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms" Version="84.4.10" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
