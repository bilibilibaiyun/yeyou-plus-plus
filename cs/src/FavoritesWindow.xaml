<Window x:Class="YeyouPlusPlus.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收藏夹" Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBg}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="FavoriteList" Grid.Row="0"
                 MouseDoubleClick="FavoriteList_MouseDoubleClick"
                 DisplayMemberPath="Name"
                 Background="{DynamicResource Theme.CardBg}"
                 Foreground="{DynamicResource Theme.TextPrimary}"
                 BorderBrush="{DynamicResource Theme.Border}"
                 BorderThickness="1">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="ToolTip" Value="{Binding Url}"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="删除选中" Width="80" Height="30" Margin="0,0,6,0" Click="DeleteButton_Click"/>
            <Button Content="关闭" Width="60" Height="30" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
