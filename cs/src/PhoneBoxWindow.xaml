<Window x:Class="YeyouPlusPlus.PhoneBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程联机" Height="480" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.WindowBg}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="手机盒子 · 远程联机" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="在手机端输入下方联机码即可连接，实现同屏双人游戏。"
                       FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 联机码卡片 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="联机码" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}"/>
                <TextBlock x:Name="JoinCodeText"
                           Text="— — — — — — — — — — — —"
                           FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Accent}"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CopyButton" Content="复制联机码" Height="32" Padding="14,0"
                            Click="CopyButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 本机地址 + 连接状态 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="本机地址" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}"/>
                <TextBlock x:Name="AddressText" Text="—" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="连接状态" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}"/>
                <TextBlock x:Name="StatusText" Text="未启动" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 最近按键（调试反馈） -->
        <TextBlock x:Name="KeyInfoText" Grid.Row="3"
                   Text="按键：无" FontSize="12"
                   Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,10,0,0"/>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="GenerateCodeButton" Content="生成联机码" Height="34" Padding="16,0"
                    Margin="0,0,8,0" Click="GenerateCodeButton_Click"/>
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="开始推流"
                    Height="34" Padding="16,0" Margin="0,0,8,0" Click="StartButton_Click"/>
            <Button x:Name="StopButton" Content="停止推流" Height="34" Padding="16,0"
                    Margin="0,0,8,0" Click="StopButton_Click"/>
            <Button Content="关闭" Height="34" Padding="16,0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
