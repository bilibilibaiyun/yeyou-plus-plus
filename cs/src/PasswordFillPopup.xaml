<Window x:Class="YeyouPlusPlus.PasswordFillPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <Border Background="{DynamicResource Theme.CardBg}"
            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
            CornerRadius="10" Padding="4" MinWidth="240" MaxWidth="320">
        <StackPanel>
            <TextBlock Text="选择账号" FontSize="12" Margin="8,6,8,2"
                       Foreground="{DynamicResource Theme.TextSecondary}"/>
            <ListBox x:Name="AccountList" MaxHeight="220" MinHeight="40"
                     Background="Transparent" BorderThickness="0"
                     MouseLeftButtonUp="AccountList_MouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Site}" FontSize="11" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Theme.TextSecondary}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
